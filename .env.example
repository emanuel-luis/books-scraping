# Copy to .env to override defaults. Every variable is optional and none is a secret.
# BOOKS_BASE_URL=https://books.toscrape.com/
# Where the raw, processed and warehouse files live (gitignored).
# BOOKS_DATA_DIR=data
# Sent with every request; default: books-scraping/<version> (+https://github.com/emanuel-luis/books-scraping)
# BOOKS_USER_AGENT=
# Minimum seconds between two requests (a robots.txt Crawl-delay can raise it).
# BOOKS_MIN_INTERVAL_S=0.5
# BOOKS_TIMEOUT_S=20
# BOOKS_MAX_RETRIES=4
# Frankfurter (ECB reference rates), no API key.
# BOOKS_FX_URL=https://api.frankfurter.dev/v1
# BOOKS_FX_QUOTES=EUR,USD,BRL
# BOOKS_LOG_LEVEL=INFO
